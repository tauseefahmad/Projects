<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_open"
        android:shortcutId="open"
        android:shortcutLongLabel="@string/open_pdf"
        android:shortcutShortLabel="@string/shortcut_open">
        <intent
            android:action="com.example.pdfreader.action.OPEN"
            android:targetClass="com.example.pdfreader.MainActivity"
            android:targetPackage="com.example.pdfreader" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_scan"
        android:shortcutId="scan"
        android:shortcutLongLabel="@string/scan_title"
        android:shortcutShortLabel="@string/shortcut_scan">
        <intent
            android:action="com.example.pdfreader.action.SCAN"
            android:targetClass="com.example.pdfreader.MainActivity"
            android:targetPackage="com.example.pdfreader" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_library"
        android:shortcutId="library"
        android:shortcutLongLabel="@string/library_title"
        android:shortcutShortLabel="@string/library_title">
        <intent
            android:action="com.example.pdfreader.action.LIBRARY"
            android:targetClass="com.example.pdfreader.MainActivity"
            android:targetPackage="com.example.pdfreader" />
    </shortcut>
</shortcuts>
