<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/formBar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurfaceContainer"
    android:orientation="vertical"
    android:paddingHorizontal="8dp"
    android:paddingTop="4dp"
    android:visibility="gone">

    <TextView
        android:id="@+id/formFieldLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingHorizontal="8dp"
        android:textAppearance="?attr/textAppearanceLabelMedium" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/formPrev"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/previous_field"
            android:src="@drawable/ic_chevron_up" />

        <ImageButton
            android:id="@+id/formNext"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/next_field"
            android:src="@drawable/ic_chevron_down" />

        <EditText
            android:id="@+id/formInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:importantForAutofill="no"
            android:maxLines="4"
            android:minHeight="48dp" />

        <ImageButton
            android:id="@+id/formPickDate"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/pick_date"
            android:src="@drawable/ic_calendar"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/formDone"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="@string/done" />
    </LinearLayout>

    <TextView
        android:id="@+id/formError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="8dp"
        android:paddingBottom="4dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorError"
        android:visibility="gone" />
</LinearLayout>
